# Copy these values into your shell or a local .env file (never commit secrets).
# The launchers already provide defaults; set these when models/data live outside
# the repository checkout.
MODEL_PATH=/path/to/models/Llama-3.2-1B-Instruct
DATA_ROOT=/path/to/datasets
CACHE_DIR=/path/to/cache/huggingface
OUTPUT_DIR=/path/to/LatentHalt/outputs
LOG_ROOT=/path/to/LatentHalt/logs

# For gated Hugging Face models, authenticate with `huggingface-cli login` or
# the standard HF_TOKEN environment variable. Do not put tokens in this file.
